
<%- include('../partials/header') %>

<!-- Panda and login form wrapper -->
<div class="auth-panda-layout">

  <!-- Animated panda -->
  <%- include('../partials/panda') %>

  <!-- Your existing login form -->
  <section class="auth-card">

    <h1>Welcome back</h1>
    <p class="muted">Continue building your skills.</p>

    <form class="auth-form" action="/login" method="POST" novalidate>

      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label for="email">Email</label>
        <input
          id="email"
          type="email"
          name="email"
          value="<%= values.email || '' %>"
          placeholder="you@example.com"
          required
          autocomplete="email"
        >
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input
          id="password"
          type="password"
          name="password"
          placeholder="Your password"
          required
          autocomplete="current-password"
          data-panda-password
        >
      </div>

      <p><a href="/forgot-password">Forgot your password?</a></p>

      <button class="btn btn-primary btn-block" type="submit">
        Log in
      </button>

      <p>New here? <a href="/register">Create an account</a></p>

    </form>

  </section>

</div>

<!-- Panda animation JavaScript -->
<script src="/js/panda-animation.js"></script>

<%- include('../partials/footer') %>
