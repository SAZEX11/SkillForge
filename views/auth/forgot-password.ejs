<%- include('../partials/header') %>
<section class="auth-card">
  <h1>Forgot your password?</h1>
  <p class="muted">Enter your email and we’ll generate a reset link that is valid for one hour.</p>
  <form class="auth-form" action="/forgot-password" method="POST" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group"><label for="email">Email</label>
      <input id="email" type="email" name="email" value="<%= values.email || '' %>" placeholder="you@example.com" required autocomplete="email"></div>
    <button class="btn btn-primary btn-block" type="submit">Send reset link</button>
    <p><a href="/login">Back to log in</a></p>
  </form>
</section>
<%- include('../partials/footer') %>
