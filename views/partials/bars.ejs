<% const top = Math.max(1, ...rows.map(function (r) { return Number(r.value); })); %>
<% if (!rows.length) { %><p class="muted">No data yet.</p><% } %>
<% rows.forEach(function (r) { %>
  <div class="skill-row"><span class="skill-name"><%= r.label %></span>
    <div class="progress"><div class="progress-bar" style="width: <%= Math.round(Number(r.value) / top * 100) %>%"></div></div>
    <span class="badge"><%= r.value %><%= typeof suffix !== 'undefined' ? suffix : '' %></span></div>
<% }) %>
