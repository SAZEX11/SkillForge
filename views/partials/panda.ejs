<div class="panda-mascot" aria-hidden="true">
  <svg
    class="panda-svg"
    viewBox="0 0 320 230"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- Ears -->
    <circle cx="85" cy="65" r="37" fill="#29233C"/>
    <circle cx="235" cy="65" r="37" fill="#29233C"/>

    <!-- Panda face -->
    <ellipse
      cx="160"
      cy="105"
      rx="104"
      ry="95"
      fill="#FFFFFF"
      stroke="#29233C"
      stroke-width="5"
    />

    <!-- Eye patches -->
    <ellipse cx="119" cy="100" rx="24" ry="31"
             fill="#29233C" transform="rotate(15 119 100)"/>
    <ellipse cx="201" cy="100" rx="24" ry="31"
             fill="#29233C" transform="rotate(-15 201 100)"/>

    <!-- Eyes -->
    <g class="panda-eyes">
      <circle cx="124" cy="98" r="8" fill="white"/>
      <circle cx="196" cy="98" r="8" fill="white"/>
    </g>

    <!-- Blush -->
    <ellipse cx="83" cy="139" rx="16" ry="9" fill="#F39AB5"/>
    <ellipse cx="237" cy="139" rx="16" ry="9" fill="#F39AB5"/>

    <!-- Nose -->
    <path d="M148 133 Q160 122 172 133 L160 147 Z"
          fill="#29233C"/>

    <!-- Mouth -->
    <path d="M160 146 Q160 166 143 158"
          stroke="#29233C" stroke-width="4"
          fill="none" stroke-linecap="round"/>
    <path d="M160 146 Q160 166 177 158"
          stroke="#29233C" stroke-width="4"
          fill="none" stroke-linecap="round"/>

    <!-- Left paw -->
    <g class="panda-paw panda-paw-left">
      <rect x="76" y="151" width="48" height="75"
            rx="22" fill="#29233C"
            stroke="#181426" stroke-width="3"/>
      <circle cx="88" cy="167" r="5" fill="#FFFFFF"/>
      <circle cx="112" cy="167" r="5" fill="#FFFFFF"/>
      <ellipse cx="100" cy="199" rx="14" ry="17" fill="#FFFFFF"/>
    </g>

    <!-- Right paw -->
    <g class="panda-paw panda-paw-right">
      <rect x="196" y="151" width="48" height="75"
            rx="22" fill="#29233C"
            stroke="#181426" stroke-width="3"/>
      <circle cx="208" cy="167" r="5" fill="#FFFFFF"/>
      <circle cx="232" cy="167" r="5" fill="#FFFFFF"/>
      <ellipse cx="220" cy="199" rx="14" ry="17" fill="#FFFFFF"/>
    </g>
  </svg>
</div>