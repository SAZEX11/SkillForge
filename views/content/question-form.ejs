<%- include('../partials/header') %>
<%- include('../partials/content-nav') %>
<section class="card narrow"><h1><%= q.id ? 'Edit question' : 'New question' %></h1>
<form class="auth-form" action="<%= q.id ? '/content/questions/' + q.id : '/content/questions' %>" method="POST">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="form-group"><label for="text">Question</label><textarea id="text" name="text" rows="3" required><%= q.text %></textarea></div>
  <div class="form-group"><label for="difficulty">Difficulty</label><select id="difficulty" name="difficulty"><% DIFFICULTIES.forEach(function (d) { %><option <%= q.difficulty === d ? 'selected' : '' %>><%= d %></option><% }) %></select></div>
  <fieldset class="form-group"><legend>Answer options (fill at least two, select the correct one)</legend>
    <% q.options.forEach(function (o, i) { %>
      <div class="option-row"><input type="radio" name="correct" value="<%= i %>" <%= o.is_correct ? 'checked' : '' %> aria-label="Option <%= i + 1 %> is correct">
        <input type="hidden" name="option_id" value="<%= o.id || '' %>">
        <input name="option_text" value="<%= o.option_text %>" placeholder="Option <%= i + 1 %>" aria-label="Option <%= i + 1 %> text"></div>
    <% }) %></fieldset>
  <fieldset class="form-group"><legend>Skills tested</legend>
    <% skills.forEach(function (s) { %><label class="chip-check"><input type="checkbox" name="skill_ids" value="<%= s.id %>" <%= q.skill_ids.includes(s.id) ? 'checked' : '' %>> <%= s.name %></label><% }) %></fieldset>
  <div class="form-group"><label for="explanation">Explanation (shown after submission)</label><textarea id="explanation" name="explanation" rows="3"><%= q.explanation || '' %></textarea></div>
  <button class="btn btn-primary" type="submit">Save question</button><a class="btn btn-outline" href="/content/questions">Cancel</a>
</form></section>
<%- include('../partials/footer') %>
