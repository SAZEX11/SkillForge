
<%- include('../partials/header') %>

<main class="sf-landing">

  <!-- HERO -->
  <section class="sf-hero">
    <div class="sf-hero-content sf-reveal">
      <span class="sf-eyebrow">
        <span class="sf-eyebrow-dot"></span>
        YOUR SKILLS. YOUR FUTURE.
      </span>

      <h1>
        Your potential is greater than your
        <span>current skills.</span>
      </h1>

      <p class="sf-hero-description">
        Discover what you know, identify the skills you need,
        and build a personalized learning path towards your
        career goals.
      </p>

      <div class="sf-hero-actions">
        <a class="sf-btn sf-btn-primary" href="/register">
          Start your journey
          <span aria-hidden="true">→</span>
        </a>
        <a class="sf-btn sf-btn-secondary" href="#how-it-works">
          Explore how it works
        </a>
      </div>

      <div class="sf-hero-note">
        <span class="sf-note-check">✓</span>
        Start learning at your own level
      </div>
    </div>

    <div class="sf-hero-visual sf-reveal">
      <div class="sf-photo-frame">
        <img
          src="/images/hero-students.png"
          alt="Students working together on laptops"
          class="sf-hero-photo"
        >
      </div>

      <div class="sf-floating-card sf-floating-top">
        <div class="sf-floating-icon">↗</div>
        <div>
          <strong>Keep improving</strong>
          <small>One skill at a time</small>
        </div>
      </div>

      <div class="sf-floating-card sf-floating-bottom">
        <div class="sf-progress-heading">
          <span>Your learning journey</span>
          <strong>75%</strong>
        </div>
        <div class="sf-progress-track">
          <span></span>
        </div>
        <small>Every step moves you forward.</small>
      </div>
    </div>
  </section>


  <!-- PRODUCT INTRODUCTION -->
  <section class="sf-product-section sf-reveal">
    <div class="sf-section-heading">
      <span class="sf-eyebrow">A CLEARER WAY TO GROW</span>
      <h2>Turn your skills into a <span>career advantage.</span></h2>
      <p>
        SkillForge brings assessment, skill analysis and guided
        learning together in one place.
      </p>
    </div>

    <div class="sf-dashboard-preview">
      <div class="sf-preview-topbar">
        <div class="sf-preview-brand">
          <span class="sf-brand-mark">S</span>
          <strong>SkillForge</strong>
        </div>
        <span class="sf-preview-label">LEARNING OVERVIEW</span>
      </div>

      <div class="sf-preview-body">
        <div class="sf-preview-sidebar">
          <span class="sf-sidebar-active">Overview</span>
          <span>Assessments</span>
          <span>My Skills</span>
          <span>Roadmap</span>
        </div>

        <div class="sf-preview-main">
          <div class="sf-preview-welcome">
            <div>
              <small>YOUR PERSONAL DASHBOARD</small>
              <h3>Welcome to your learning journey</h3>
              <p>Understand your strengths and keep moving forward.</p>
            </div>
            <span class="sf-preview-avatar">S</span>
          </div>

          <div class="sf-preview-stats">
            <div class="sf-stat-box">
              <small>Skills assessed</small>
              <strong>08</strong>
              <span>Keep exploring</span>
            </div>
            <div class="sf-stat-box">
              <small>Learning progress</small>
              <strong>75%</strong>
              <span>You're making progress</span>
            </div>
            <div class="sf-stat-box">
              <small>Roadmap tasks</small>
              <strong>12</strong>
              <span>Steps to complete</span>
            </div>
          </div>

          <div class="sf-preview-lower">
            <div class="sf-skill-panel">
              <h4>Your skill overview</h4>

              <div class="sf-skill-row">
                <span>HTML & CSS</span>
                <div class="sf-skill-track"><span style="width:85%"></span></div>
                <strong>85%</strong>
              </div>

              <div class="sf-skill-row">
                <span>JavaScript</span>
                <div class="sf-skill-track"><span style="width:65%"></span></div>
                <strong>65%</strong>
              </div>

              <div class="sf-skill-row">
                <span>Database</span>
                <div class="sf-skill-track"><span style="width:55%"></span></div>
                <strong>55%</strong>
              </div>
            </div>

            <div class="sf-next-panel">
              <span class="sf-next-icon">✦</span>
              <h4>Your next step</h4>
              <p>Strengthen your JavaScript skills with your next learning activity.</p>
              <span class="sf-next-link">View learning roadmap →</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <p class="sf-preview-caption">
      A preview of the kind of learning overview SkillForge helps you build.
    </p>
  </section>


  <!-- HOW IT WORKS -->
  <section class="sf-process-section" id="how-it-works">
    <div class="sf-section-heading sf-reveal">
      <span class="sf-eyebrow">SIMPLE. PERSONAL. PRACTICAL.</span>
      <h2>Three steps towards <span>your next level.</span></h2>
      <p>
        A structured journey that helps you understand where you are
        and what to work on next.
      </p>
    </div>

    <div class="sf-process-grid">
      <article class="sf-process-item sf-reveal">
        <div class="sf-process-number">01</div>
        <div class="sf-process-icon">⌁</div>
        <h3>Assess your skills</h3>
        <p>
          Take technical assessments to discover your current
          knowledge and understand your starting point.
        </p>
        <span class="sf-process-tag">Discover your level</span>
      </article>

      <article class="sf-process-item sf-reveal">
        <div class="sf-process-number">02</div>
        <div class="sf-process-icon">◈</div>
        <h3>Understand your gaps</h3>
        <p>
          Explore your results, identify stronger areas and
          see which skills need more attention.
        </p>
        <span class="sf-process-tag">Know what to improve</span>
      </article>

      <article class="sf-process-item sf-reveal">
        <div class="sf-process-number">03</div>
        <div class="sf-process-icon">↗</div>
        <h3>Follow your roadmap</h3>
        <p>
          Use a personalized learning roadmap to focus on
          meaningful steps and track your progress.
        </p>
        <span class="sf-process-tag">Keep moving forward</span>
      </article>
    </div>
  </section>


  <!-- FEATURE SHOWCASE -->
  <section class="sf-feature-section">

    <div class="sf-feature-row sf-reveal">
      <div class="sf-feature-image">
        <img
          src="/images/skill-development.png"
          alt="Person learning and working on a laptop"
          loading="lazy"
        >
      </div>

      <div class="sf-feature-copy">
        <span class="sf-eyebrow">01 / UNDERSTAND YOURSELF</span>
        <h2>See your skills more clearly.</h2>
        <p>
          Go beyond simply completing a test. Explore your
          assessment results and understand which technical
          areas are your strengths and where you can improve.
        </p>
        <a href="/features" class="sf-text-link">
          Explore skill analytics <span>→</span>
        </a>
      </div>
    </div>

    <div class="sf-feature-row sf-feature-reverse sf-reveal">
      <div class="sf-feature-image">
        <img
          src="/images/learning-roadmap.png"
          alt="Notebook and study materials on a desk"
          loading="lazy"
        >
      </div>

      <div class="sf-feature-copy">
        <span class="sf-eyebrow">02 / LEARN WITH DIRECTION</span>
        <h2>A roadmap that gives you a next step.</h2>
        <p>
          Turn skill gaps into practical learning goals.
          Follow prioritized roadmap activities and use
          learning resources to strengthen your knowledge.
        </p>
        <a href="/features" class="sf-text-link">
          Discover personalized roadmaps <span>→</span>
        </a>
      </div>
    </div>

    <div class="sf-feature-row sf-reveal">
      <div class="sf-feature-image">
        <img
          src="/images/career-growth.png"
          alt="A team collaborating around a laptop"
          loading="lazy"
        >
      </div>

      <div class="sf-feature-copy">
        <span class="sf-eyebrow">03 / KEEP MAKING PROGRESS</span>
        <h2>Make every improvement count.</h2>
        <p>
          Keep track of completed activities, learning
          achievements and progress over time. Build
          consistency as you work towards your goals.
        </p>
        <a href="/features" class="sf-text-link">
          Explore progress tracking <span>→</span>
        </a>
      </div>
    </div>

  </section>


  <!-- FINAL CTA -->
  <section class="sf-final-cta sf-reveal">
    <div class="sf-cta-decoration sf-cta-decoration-one"></div>
    <div class="sf-cta-decoration sf-cta-decoration-two"></div>

    <span class="sf-eyebrow">YOUR NEXT CHAPTER STARTS HERE</span>
    <h2>Ready to discover what you're capable of?</h2>
    <p>
      Take the first step towards understanding your skills
      and building a stronger learning journey.
    </p>
    <a href="/register" class="sf-btn sf-btn-light">
      Create your free account <span>→</span>
    </a>
  </section>

</main>

<script src="/js/landing.js" defer></script>

<%- include('../partials/footer') %>
