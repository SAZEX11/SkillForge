<%- include('../partials/header') %>
<section class="card narrow">
  <h1>Settings</h1>
  <form class="auth-form" action="/settings" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="option"><input type="checkbox" name="email_notifications" <%= emailNotifications ? 'checked' : '' %>><span>Email me about results and achievements</span></label>
    <button class="btn btn-primary" type="submit">Save settings</button>
  </form>
  <h2>Change password</h2>
  <form class="auth-form" action="/settings/password" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group"><label for="current_password">Current password</label><input id="current_password" type="password" name="current_password" required autocomplete="current-password"></div>
    <div class="form-group"><label for="new_password">New password (min 8)</label><input id="new_password" type="password" name="new_password" minlength="8" required autocomplete="new-password"></div>
    <div class="form-group"><label for="confirm_password">Confirm new password</label><input id="confirm_password" type="password" name="confirm_password" required autocomplete="new-password"></div>
    <button class="btn btn-primary" type="submit">Update password</button>
  </form>
</section>
<%- include('../partials/footer') %>
