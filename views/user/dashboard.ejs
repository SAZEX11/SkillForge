<%- include('../partials/header') %>
<%
  function level(score) {
    if (score >= 80) return ['Strong', 'success'];
    if (score >= 60) return ['Developing', 'info'];
    if (score >= 40) return ['Building', 'warning'];
    return ['Needs focus', 'danger'];
  }
  const hasProgress = skills.length > 0 || recent.length > 0;
%>
<section class="welcome-panel learner-welcome">
  <div><span class="eyebrow">YOUR LEARNING SPACE</span><h1><%= greeting %>, <%= currentUser.name.split(' ')[0] %>!</h1>
    <p>Small steps build strong skills. Check your progress and choose what to work on next.</p>
    <a class="action-primary" href="/assessments">Explore assessments <span>→</span></a>
  </div>
  <div class="welcome-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="art-cap">✦</div><div class="art-dot dot-one"></div><div class="art-dot dot-two"></div></div>
</section>
<section class="dashboard-section">
  <div class="section-heading"><div><span class="eyebrow">YOUR SNAPSHOT</span><h2>Learning at a glance</h2></div><a class="text-link" href="/progress">View all progress →</a></div>
  <div class="stat-grid learner-stats">
    <article class="metric-card"><span class="metric-icon teal-icon">◎</span><span class="stat-label">Overall skill score</span><strong><%= stats.overall === null ? '—' : Math.round(stats.overall) + '%' %></strong><small>Across your tracked skills</small></article>
    <article class="metric-card"><span class="metric-icon blue-icon">▤</span><span class="stat-label">Completed assessments</span><strong><%= stats.completed %></strong><small>Knowledge checks completed</small></article>
    <article class="metric-card"><span class="metric-icon amber-icon">↗</span><span class="stat-label">Average score</span><strong><%= stats.avg_score === null ? '—' : Math.round(stats.avg_score) + '%' %></strong><small>Your assessment average</small></article>
    <article class="metric-card"><span class="metric-icon violet-icon">✧</span><span class="stat-label">Achievements</span><strong><%= stats.achievements %></strong><small>Milestones unlocked</small></article>
  </div>
</section>
<section class="dashboard-section">
  <div class="section-heading"><div><span class="eyebrow">KEEP MOVING FORWARD</span><h2>Your next steps</h2></div></div>
  <div class="quick-grid">
    <a class="quick-card" href="/assessments"><span class="quick-icon">▤</span><span><strong>Take an assessment</strong><small>Check your knowledge and discover gaps.</small></span><b>→</b></a>
    <a class="quick-card" href="/roadmap"><span class="quick-icon">⌁</span><span><strong>Follow your roadmap</strong><small>Turn your goals into manageable steps.</small></span><b>→</b></a>
    <a class="quick-card" href="/resources"><span class="quick-icon">▣</span><span><strong>Explore resources</strong><small>Find material to strengthen your skills.</small></span><b>→</b></a>
  </div>
</section>
<section class="dashboard-columns dashboard-section">
  <article class="panel-card">
    <div class="section-heading compact"><div><span class="eyebrow">SKILL DEVELOPMENT</span><h2>Skill performance</h2></div><a class="text-link" href="/skill-analysis">Details →</a></div>
    <% if (!skills.length) { %><div class="empty-state"><span>◎</span><strong>Your skill map starts here</strong><p>Complete your first assessment to see strengths and areas to improve.</p><a class="text-link" href="/assessments">Find an assessment →</a></div><% } %>
    <% skills.forEach(function (s) { const l = level(Number(s.score) || 0); const score = Math.max(0, Math.min(100, Number(s.score) || 0)); %>
      <div class="skill-item"><div class="skill-meta"><strong><%= s.name %></strong><span><%= Math.round(score) %>% · <em class="level-<%= l[1] %>"><%= l[0] %></em></span></div><div class="progress-track"><div class="progress-fill" style="width:<%= score %>%"></div></div></div>
    <% }) %>
  </article>
  <article class="panel-card">
    <div class="section-heading compact"><div><span class="eyebrow">RECENT WORK</span><h2>Assessment activity</h2></div></div>
    <% if (!recent.length) { %><div class="empty-state"><span>◷</span><strong>No assessments yet</strong><p>Your completed assessments and scores will appear here.</p></div><% } %>
    <% recent.forEach(function (r) { %><div class="recent-item"><span class="recent-mark">✓</span><div><strong><%= r.title %></strong><small><%= new Date(r.completed_at).toLocaleDateString() %></small></div><b><%= Math.round(Number(r.score) || 0) %>%</b></div><% }) %>
    <% if (recent.length) { %><a class="text-link panel-link" href="/progress">See your learning history →</a><% } %>
  </article>
</section>
<%- include('../partials/footer') %>
